  {
    "id": "mqtt_fix",
    "type": "mqtt in",
    "z": "flow_gps_demo",
    "name": "Fix",
    "topic": "gps/v1/+/fix",
    "qos": "1",
    "datatype": "auto-detect",
    "broker": "broker_local",
    "nl": false,
    "rap": true,
    "rh": 0,
    "inputs": 0,
    "x": 90,
    "y": 80,
    "wires": [["json_fix"]]
  },
  {
    "id": "json_fix",
    "type": "json",
    "z": "flow_gps_demo",
    "name": "Parse Fix",
    "property": "payload",
    "action": "obj",
    "pretty": false,
    "x": 250,
    "y": 80,
    "wires": [["fn_coords", "fn_speed", "fn_distance", "fn_avg_speed", "fn_speed_chart", "fn_map_data"]]
  },
  {
    "id": "fn_coords",
    "type": "function",
    "z": "flow_gps_demo",
    "name": "Coords Text",
    "func": "const p = msg.payload || {};\nconst lat = typeof p.lat === 'number' ? p.lat.toFixed(6) : 'n/a';\nconst lon = typeof p.lon === 'number' ? p.lon.toFixed(6) : 'n/a';\nmsg.payload = `${lat}, ${lon}`;\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 430,
    "y": 40,
    "wires": [["ui_coords"]]
  },
  {
    "id": "fn_speed",
    "type": "function",
    "z": "flow_gps_demo",
    "name": "Current Speed",
    "func": "const speedMps = Number(msg.payload?.speedMps);\nif (!Number.isFinite(speedMps)) {\n    msg.payload = 0;\n    return msg;\n}\nmsg.payload = Number((speedMps * 3.6).toFixed(1));\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 430,
    "y": 80,
    "wires": [["ui_speed"]]
  },
  {
    "id": "fn_distance",
    "type": "function",
    "z": "flow_gps_demo",
    "name": "Distance Text",
    "func": "const distance = Number(msg.payload?.distanceTotalM ?? 0);\nmsg.payload = Number.isFinite(distance) ? `${distance.toFixed(1)} m` : 'n/a';\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 440,
    "y": 120,
    "wires": [["ui_distance"]]
  },
  {
    "id": "fn_avg_speed",
    "type": "function",
    "z": "flow_gps_demo",
    "name": "Avg Speed Text",
    "func": "const averageMps = Number(msg.payload?.averageSpeedMps);\nif (!Number.isFinite(averageMps)) {\n    msg.payload = 'n/a';\n    return msg;\n}\nmsg.payload = (averageMps * 3.6).toFixed(1);\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 450,
    "y": 160,
    "wires": [["ui_avg_speed"]]
  },
  {
    "id": "fn_speed_chart",
    "type": "function",
    "z": "flow_gps_demo",
    "name": "Speed Chart",
    "func": "const speedMps = Number(msg.payload?.speedMps);\nif (!Number.isFinite(speedMps)) {\n    msg.payload = 0;\n    return msg;\n}\nmsg.payload = Number((speedMps * 3.6).toFixed(1));\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 440,
    "y": 200,
    "wires": [["ui_speed_chart"]]
  },
  {
    "id": "mqtt_status",
    "type": "mqtt in",
    "z": "flow_gps_demo",
