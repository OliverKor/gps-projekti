  {
    "id": "fn_alert",
    "type": "function",
    "z": "flow_gps_demo",
    "name": "Alert Text",
    "func": "const p = msg.payload || {};\nmsg.payload = `${p.severity ?? 'info'}: ${p.code ?? 'N/A'} - ${p.message ?? ''}`;\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 430,
    "y": 340,
    "wires": [["ui_alert"]]
  },
  {
