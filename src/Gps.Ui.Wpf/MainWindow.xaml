<Window x:Class="Gps.Ui.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GPS Track"
        Height="650"
        Width="1000"
        MinHeight="520"
        MinWidth="760">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="280" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="Status"
                   FontSize="16"
                   Margin="0,0,0,10" />

        <Border Grid.Row="1"
                BorderBrush="#222"
                BorderThickness="1"
                Background="#111"
                Margin="0,0,0,10">
            <Canvas x:Name="MapCanvas" />
        </Border>

        <ListView x:Name="Fixes" Grid.Row="2">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Time" DisplayMemberBinding="{Binding Timestamp}" Width="220" />
                    <GridViewColumn Header="Lat" DisplayMemberBinding="{Binding LatitudeDeg}" Width="120" />
                    <GridViewColumn Header="Lat m" DisplayMemberBinding="{Binding LatitudeMeters}" Width="90" />
                    <GridViewColumn Header="Lon" DisplayMemberBinding="{Binding LongitudeDeg}" Width="120" />
                    <GridViewColumn Header="Lon m" DisplayMemberBinding="{Binding LongitudeMeters}" Width="90" />
                    <GridViewColumn Header="Speed" DisplayMemberBinding="{Binding SpeedMps}" Width="80" />
                    <GridViewColumn Header="SV" DisplayMemberBinding="{Binding NumSv}" Width="50" />
                    <GridViewColumn Header="Fix" DisplayMemberBinding="{Binding FixType}" Width="90" />
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</Window>
