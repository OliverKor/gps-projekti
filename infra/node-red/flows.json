  },
  {
    "id": "fn_status",
    "type": "function",
    "z": "flow_gps_demo",
    "name": "Status Text",
    "func": "const p = msg.payload || {};\nconst reason = p.reason ? ` (${p.reason})` : '';\nmsg.payload = `${p.state ?? 'unknown'}${reason}`;\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 430,
    "y": 280,
    "wires": [["ui_status"]]
  },
  {
