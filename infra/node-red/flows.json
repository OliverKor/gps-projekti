  {
    "id": "fn_map_data",
    "type": "function",
    "z": "flow_gps_demo",
    "name": "Format Map Data",
    "func": "const p = msg.payload || {};\nif (typeof p.lat === 'number' && typeof p.lon === 'number') {\n    msg.payload = {\n        name: \"Vehicle\",\n        lat: p.lat,\n        lon: p.lon,\n        speed: p.speedMps ? p.speedMps * 3.6 : 0,\n        icon: \"car\",\n        iconColor: \"blue\",\n        track: true,\n        layer: \"GPS Track\"\n    };\n    return msg;\n}\nreturn null;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 450,
    "y": 480,
    "wires": [["op_worldmap"]]
  },
