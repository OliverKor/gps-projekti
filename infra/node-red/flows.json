  {
    "id": "mqtt_fix",
    "type": "mqtt in",
    "z": "flow_gps_demo",
    "name": "Fix",
    "topic": "gps/v1/+/fix",
    "qos": "1",
    "datatype": "auto-detect",
    "broker": "broker_local",
    "nl": false,
    "rap": true,
    "rh": 0,
    "inputs": 0,
    "x": 90,
    "y": 80,
    "wires": [["json_fix"]]
  },
  {
    "id": "json_fix",
    "type": "json",
    "z": "flow_gps_demo",
    "name": "Parse Fix",
    "property": "payload",
    "action": "obj",
    "pretty": false,
    "x": 250,
    "y": 80,
    "wires": [["fn_coords", "fn_speed", "fn_distance", "fn_avg_speed", "fn_speed_chart"]]
  },
  {
    "id": "fn_coords",
    "type": "function",
    "z": "flow_gps_demo",
    "name": "Coords Text",
    "func": "const p = msg.payload || {};\nconst lat = typeof p.lat === 'number' ? p.lat.toFixed(6) : 'n/a';\nconst lon = typeof p.lon === 'number' ? p.lon.toFixed(6) : 'n/a';\nmsg.payload = `${lat}, ${lon}`;\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 430,
    "y": 40,
    "wires": [["ui_coords"]]
  },
  {
    "id": "fn_speed",
    "type": "function",
    "z": "flow_gps_demo",
    "name": "Current Speed",
    "func": "const speed = Number(msg.payload?.speedMps ?? 0);\nmsg.payload = Number.isFinite(speed) ? speed : 0;\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 430,
    "y": 80,
    "wires": [["ui_speed"]]
  },
  {
    "id": "fn_distance",
    "type": "function",
    "z": "flow_gps_demo",
    "name": "Distance Text",
    "func": "const distance = Number(msg.payload?.distanceTotalM ?? 0);\nmsg.payload = Number.isFinite(distance) ? `${distance.toFixed(1)} m` : 'n/a';\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 440,
    "y": 120,
    "wires": [["ui_distance"]]
  },
  {
    "id": "fn_avg_speed",
    "type": "function",
    "z": "flow_gps_demo",
    "name": "Avg Speed Text",
    "func": "const avg = Number(msg.payload?.averageSpeedMps ?? 0);\nmsg.payload = Number.isFinite(avg) ? `${avg.toFixed(2)} m/s` : 'n/a';\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 450,
    "y": 160,
    "wires": [["ui_avg_speed"]]
  },
  {
    "id": "fn_speed_chart",
    "type": "function",
    "z": "flow_gps_demo",
    "name": "Speed Chart",
    "func": "const speed = Number(msg.payload?.speedMps ?? 0);\nmsg.payload = Number.isFinite(speed) ? speed : 0;\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 440,
    "y": 200,
    "wires": [["ui_speed_chart"]]
  },
  {
    "id": "mqtt_status",
    "type": "mqtt in",
    "z": "flow_gps_demo",
    "name": "Status",
    "topic": "gps/v1/+/status",
    "qos": "1",
    "datatype": "auto-detect",
    "broker": "broker_local",
    "nl": false,
    "rap": true,
    "rh": 0,
    "inputs": 0,
    "x": 90,
    "y": 280,
    "wires": [["json_status"]]
  },
  {
    "id": "json_status",
    "type": "json",
    "z": "flow_gps_demo",
    "name": "Parse Status",
    "property": "payload",
    "action": "obj",
    "pretty": false,
    "x": 260,
    "y": 280,
    "wires": [["fn_status"]]
  },
  {
    "id": "fn_status",
    "type": "function",
    "z": "flow_gps_demo",
    "name": "Status Text",
    "func": "const p = msg.payload || {};\nconst reason = p.reason ? ` (${p.reason})` : '';\nmsg.payload = `${p.state ?? 'unknown'}${reason}`;\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 430,
    "y": 280,
    "wires": [["ui_status"]]
  },
  {
    "id": "mqtt_alert",
    "type": "mqtt in",
    "z": "flow_gps_demo",
    "name": "Alert",
    "topic": "gps/v1/+/alert",
    "qos": "1",
    "datatype": "auto-detect",
