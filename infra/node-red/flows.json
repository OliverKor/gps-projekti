  {
    "id": "fn_last_update",
    "type": "function",
    "z": "flow_gps_demo",
    "name": "Last Update Age",
    "func": "const tsText = msg.payload?.tsUtc;\nconst ts = Date.parse(tsText ?? '');\nif (Number.isNaN(ts)) {\n    msg.payload = 'n/a';\n    return msg;\n}\nconst age = (Date.now() - ts) / 1000;\nmsg.payload = `${Math.max(age, 0).toFixed(1)} s`;\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 440,
    "y": 400,
    "wires": [["ui_last_update"]]
  },
